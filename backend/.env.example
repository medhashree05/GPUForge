# Copy to backend/.env and adjust. All values are optional.

# Directory containing clang and opt (not needed if they are on PATH
# or installed in C:\Program Files\LLVM\bin).
GPUFORGE_LLVM_BIN_DIR=C:\Program Files\LLVM\bin

# Explicit executable paths (override discovery)
# GPUFORGE_CLANG_PATH=
# GPUFORGE_OPT_PATH=
# GPUFORGE_NVCC_PATH=

# Limits
# GPUFORGE_COMPILE_TIMEOUT_S=20
# GPUFORGE_MAX_SOURCE_BYTES=65536
